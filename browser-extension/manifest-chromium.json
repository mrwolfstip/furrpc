{
  "manifest_version": 3,
  "name": "furrpc browser media",
  "version": "1.2.1",
  "description": "Sends playing browser media to furrpc on this Mac.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["tabs", "storage"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:49193/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "configure furrpc sources" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["sources.js", "content.js"],
    "run_at": "document_idle"
  }]
}
